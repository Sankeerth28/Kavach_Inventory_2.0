# KAVACH environment. Copy to .env (never commit .env) and fill in real values.
# Placeholders only. Full reference: README.md §2 and docs/ENV_SETUP.md (v2.1 additions).

# ───────────────────────── v2.0: core ─────────────────────────
# PostgreSQL connection string (Supabase: Connect → Session pooler).
DATABASE_URL=postgresql://kavach:kavach@localhost:5432/kavach?schema=public
# Optional: server where the integration tests create a throwaway database (defaults to DATABASE_URL).
# TEST_DATABASE_URL=
# Secret. Random text, at least 32 characters, signs login tokens. e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-at-least-32-random-characters
# development | production
NODE_ENV=development
# API port (managed hosts set PORT instead).
API_PORT=3001
# Comma-separated web origins allowed to call the API (https:// only in production).
WEB_ORIGIN=http://localhost:3000
# true in production (HTTPS only); required by the API when NODE_ENV=production.
COOKIE_SECURE=false
# Refresh-cookie path as the browser sees it (/kapi/auth when the web app proxies the API).
COOKIE_PATH=/auth
# Number of proxies in front of the API (for client IPs in rate limits). Empty when none.
# TRUST_PROXY=
# off to silence per-request logs.
# REQUEST_LOG=
# Host port for the Docker PostgreSQL in infra/docker-compose.yml.
POSTGRES_PORT=5432

# ───────────────────────── v2.0: web and mobile ─────────────────────────
# API address used by the browser (empty when the web app proxies the API).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Where the web app proxies /kapi to.
API_PROXY_TARGET=http://localhost:3001
# API address used by the Expo mobile app (your computer's LAN IP for a real phone).
EXPO_PUBLIC_API_URL=http://localhost:3001

# ───────────────────────── v2.0: document queue (worker) ─────────────────────────
# db (poll PostgreSQL, no Redis) | bullmq (needs REDIS_URL)
DOCUMENT_QUEUE=db
# Redis connection, only for DOCUMENT_QUEUE=bullmq.
REDIS_URL=redis://localhost:6379
# Worker poll interval in ms.
DOCUMENT_POLL_MS=2000
# Documents processed in parallel (1–16).
DOCUMENT_CONCURRENCY=4
# Days before discarded/failed uploads are purged.
DOCUMENT_RETENTION_DAYS=30

# ───────────────────────── v2.0: file storage ─────────────────────────
# local (development) | s3 (production default)
STORAGE_DRIVER=local
# Directory for STORAGE_DRIVER=local (default .local/documents).
# STORAGE_LOCAL_DIR=
# S3-compatible bucket for STORAGE_DRIVER=s3.
S3_BUCKET=kavach-documents
S3_REGION=ap-south-1
# Empty for AWS; MinIO/Supabase endpoint otherwise.
# S3_ENDPOINT=
# Secret pair from the storage provider.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO/Supabase.
S3_FORCE_PATH_STYLE=false

# ───────────────────────── v2.0: AI invoice reading (optional) ─────────────────────────
# openai | fixture (offline sample documents, development only). Empty = auto.
# AI_PROVIDER=
# Secret. Empty = AI reading off (lines entered by hand).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=90000
# Directory of fixture answers for AI_PROVIDER=fixture (default test-docs/).
# AI_FIXTURE_DIR=

# ───────────────────────── v2.0: ops check ─────────────────────────
# Alert thresholds for `pnpm ops:check`.
# OPS_MAX_QUEUE_MINUTES=30
# OPS_MAX_FAILED_24H=20

# ═════════════════════════ v2.1 (docs/ENV_SETUP.md) ═════════════════════════

# ── Feature flags: env defaults. Per-project overrides live in projects.settings.features. ──
# Phase 2A: MR, store queue, acknowledgement, disputes, return requests, SE PWA.
FEATURE_REQUISITION_ENABLED=false
# Block Material Out without an MR or the Emergency flag (only works with requisition on).
FEATURE_MR_REQUIRED_FOR_ISSUE=false
# Phase 4A: activities, norms, reconciliation, budget routing.
FEATURE_CONTROL_ENABLED=false
# Indents and system-suggested indents.
FEATURE_INDENTS_ENABLED=false
# Tool Issue / Return / Write-off.
FEATURE_TOOL_CUSTODY_ENABLED=false
# WhatsApp alerts (only works with requisition on).
FEATURE_WHATSAPP_ENABLED=false

# ── Background jobs ──
# true on exactly ONE instance (runs hourly/daily jobs). Required when requisition is on.
JOBS_ENABLED=false
# IANA time zone for job schedules and the weekly report (default Asia/Kolkata).
JOBS_TIMEZONE=Asia/Kolkata

# ── Site Engineer PWA (required when requisition is on) ──
# Base URL of the SE app, used in notification links (https:// in production).
SE_PWA_URL=http://localhost:3000/se
# Max size of acknowledgement / work-progress photos in MB (1–15, default 5).
PHOTO_MAX_MB=5

# ── Web push (required when requisition is on). Generate once per environment: npx web-push generate-vapid-keys ──
# Public VAPID key (safe to expose to browsers).
VAPID_PUBLIC_KEY=
# Secret. Private VAPID key from the same command. Regenerating breaks existing subscriptions.
VAPID_PRIVATE_KEY=
# Contact for the push service: mailto:you@yourcompany.com or an https:// URL.
VAPID_SUBJECT=mailto:admin@example.com

# ── Email for the Weekly Exception Report (SMTP_HOST and SMTP_FROM required when requisition is on) ──
# SMTP relay host.
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS). Default 587.
SMTP_PORT=587
# SMTP login (set both user and password, or neither).
SMTP_USER=
# Secret. SMTP password / API key.
SMTP_PASSWORD=
# Sender address of the report.
SMTP_FROM=kavach-reports@example.com

# ── WhatsApp Business API (required when WhatsApp is on) ──
# Provider API base URL (https://).
WHATSAPP_BASE_URL=
# Secret. Provider access token.
WHATSAPP_ACCESS_TOKEN=
# Sending phone number id from the provider.
WHATSAPP_PHONE_NUMBER_ID=
# Language code of the approved templates (default en).
WHATSAPP_TEMPLATE_LANG=en
